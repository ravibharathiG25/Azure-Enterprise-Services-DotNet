{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Azure": {
    "AppService": {
      "EnvironmentName": "Development",
      "DeploymentSlot": "production",
      "AppServicePlanSku": "P1v3",
      "MinimumInstances": 1,
      "MaximumInstances": 5
    },
    "KeyVault": {
      "VaultUri": "https://kv-azureservices-demo.vault.azure.net/",
      "Enabled": false
    },
    "Storage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "BlobEndpoint": "https://stazureservicesdemo.blob.core.windows.net/",
      "QueueEndpoint": "https://stazureservicesdemo.queue.core.windows.net/",
      "TableEndpoint": "https://stazureservicesdemo.table.core.windows.net/",
      "FileEndpoint": "https://stazureservicesdemo.file.core.windows.net/",
      "BlobContainerName": "order-documents",
      "QueueName": "order-queue",
      "TableName": "OrderAudits",
      "FileShareName": "enterprise-files",
      "UseManagedIdentity": false
    },
    "ServiceBus": {
      "ConnectionString": "",
      "FullyQualifiedNamespace": "sb-azureservices-demo.servicebus.windows.net",
      "QueueName": "orders-queue",
      "TopicName": "orders-topic",
      "HighPrioritySubscription": "sub-high-priority",
      "NormalPrioritySubscription": "sub-normal-priority",
      "AuditSubscription": "sub-audit-all",
      "UseManagedIdentity": false
    },
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "Domain": "contoso.onmicrosoft.com",
      "TenantId": "common",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "Audience": "api://azure-services-demo"
    }
  }
}
